// Fast 32bpp resolve from 4x MSAA EDRAM to tiled guest memory (unscaled).
//
// Reconstructed from the shipped SPIR-V (vulkan_spirv/resolve_fast_32bpp_4xmsaa_cs.h,
// generated by `xb buildshaders`, sources not in this repo) with one fix:
//
// Each invocation writes 8 pixels = 16 horizontal samples. The original computed
// the EDRAM address of the first sample only and loaded 16 consecutive dwords.
// For depth, the two 40-sample halves of each 80-sample EDRAM tile row are
// swapped, so a run starting at sample 32 of a tile row (32..47) was mapped to
// 72..87: samples 40..47 (pixels 20..23 of each 40-pixel tile) came from the
// next sample row - or, on the last row of a tile, from another tile entirely.
// In The Bigs 2 at 1x this put garbage depth into the game's depth-of-field
// input: dashed streaks on and around players every 8 rows.
// Now each 8-sample half gets its own address (8 divides 40, so a half never
// crosses the swap boundary or a tile edge).
//
// Build: glslangValidator -V --target-env vulkan1.0 -S comp <this file>
#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer EdramSource { uvec4 data[]; } xe_edram;
layout(set = 1, binding = 0, std430) writeonly buffer ResolveDest { uvec4 data[]; } xe_dest;

layout(push_constant) uniform ResolveConstants {
  uint edram_info;           // pitch tiles (0..9), msaa (10..11), depth (12), base tiles (13..23), format (24..27)
  uint coordinate_info;      // offset x div 8 (0..3), offset y div 8 (4), width div 8 (5..15)
  uint dest_info;            // endian (0..2), 3D (3), slice (4..6), swap (24)
  uint dest_coordinate_info; // pitch div 32 (0..9), height div 32 (10..19), offset x/y div 8 (20..27), sample select (28..30)
  uint dest_base;
} xe_resolve;

uint EdramIndex(uvec2 sample_xy) {
  uvec2 tile = sample_xy / uvec2(80u, 16u);
  uvec2 in_tile = sample_xy - tile * uvec2(80u, 16u);
  if ((xe_resolve.edram_info & 4096u) != 0u) {
    // Depth: the 40-sample halves of the tile row are swapped.
    in_tile.x = in_tile.x >= 40u ? in_tile.x - 40u : in_tile.x + 40u;
  }
  uint tile_index = ((xe_resolve.edram_info >> 13u) & 2047u) +
                    tile.y * (xe_resolve.edram_info & 1023u) + tile.x;
  return ((tile_index * 1280u + in_tile.y * 80u + in_tile.x) % 2621440u) >> 2u;
}

uvec4 EndianSwap(uvec4 value, uint endian) {
  if (endian == 1u || endian == 2u) {
    value = ((value & uvec4(0x00FF00FFu)) << 8u) | ((value & uvec4(0xFF00FF00u)) >> 8u);
  }
  if (endian == 2u || endian == 3u) {
    value = (value << 16u) | (value >> 16u);
  }
  return value;
}

uvec4 RedBlueSwap(uvec4 value) {
  switch ((xe_resolve.edram_info >> 24u) & 15u) {
    case 0u:
    case 1u:
      return (value & uvec4(0xFF00FF00u)) | ((value & uvec4(0xFFu)) << 16u) |
             ((value >> 16u) & uvec4(0xFFu));
    case 2u:
    case 3u:
    case 10u:
    case 12u:
      return (value & uvec4(0xC00FFC00u)) | ((value & uvec4(0x3FFu)) << 20u) |
             ((value >> 20u) & uvec4(0x3FFu));
    default:
      return value;
  }
}

void main() {
  uint endian = xe_resolve.dest_info & 7u;
  uint dest_pitch = (xe_resolve.dest_coordinate_info & 1023u) << 5u;
  uint sample_select = (xe_resolve.dest_coordinate_info >> 28u) & 7u;
  if (gl_GlobalInvocationID.x >= ((xe_resolve.coordinate_info >> 5u) & 2047u)) {
    return;
  }
  uvec2 pixel = gl_GlobalInvocationID.xy << uvec2(3u, 0u);
  uint sample_index = sample_select <= 3u ? sample_select : (sample_select == 5u ? 2u : 0u);
  uvec2 source_sample =
      ((pixel + (((uvec2(xe_resolve.coordinate_info) >> uvec2(0u, 4u)) & uvec2(15u, 1u)) << 3u))
       << 1u) +
      ((uvec2(sample_index) >> uvec2(1u, 0u)) & 1u);

  // Pixels 0..3 and 4..7: separate addresses (see the header comment).
  uint index_low = EdramIndex(source_sample);
  uint index_high = EdramIndex(source_sample + uvec2(8u, 0u));
  uvec4 pixels_low, pixels_high;
  if (sample_select != 2u && sample_select != 3u) {
    pixels_low = uvec4(xe_edram.data[index_low].xz, xe_edram.data[index_low + 1u].xz);
    pixels_high = uvec4(xe_edram.data[index_high].xz, xe_edram.data[index_high + 1u].xz);
  } else {
    pixels_low = uvec4(xe_edram.data[index_low].yw, xe_edram.data[index_low + 1u].yw);
    pixels_high = uvec4(xe_edram.data[index_high].yw, xe_edram.data[index_high + 1u].yw);
  }
  if ((xe_resolve.dest_info & 16777216u) != 0u) {
    pixels_low = RedBlueSwap(pixels_low);
    pixels_high = RedBlueSwap(pixels_high);
  }

  // Tiled destination address of pixel 0 (pixels 4..7 are 32 bytes further).
  uvec2 dest_xy = pixel + (((uvec2(xe_resolve.dest_coordinate_info) >> uvec2(20u, 24u)) & 15u) << 3u);
  uint dest_address;
  if ((xe_resolve.dest_info & 8u) != 0u) {
    ivec3 p = ivec3(uvec3(dest_xy, (xe_resolve.dest_info >> 4u) & 7u));
    int z_high = p.z >> 2;
    int inner = (((p.x & 7) + ((p.y & 6) << 2)) << 8) >> 6;
    int bank = ((p.y >> 3) + z_high) & 1;
    int pipe = bank + ((((p.x >> 3) + (bank << 1)) & 3) << 1);
    int macro = (((((((((p.x >> 5) + (((p.y >> 4) +
                    (z_high * int((((xe_resolve.dest_coordinate_info >> 10u) & 1023u) << 5u) >> 4u))) *
                    int(dest_pitch >> 5u))) << 8) & 268435455) << 1) + (inner & -16)) << 1) +
                  (inner & 15)) + ((p.z & 3) << 8)) + ((p.y & 1) << 4);
    dest_address = uint(((((((((pipe & 1) << 3) + ((macro >> 6) & 7)) << 3) + (pipe & -2)) << 2) +
                         (macro & -512)) << 3) + (macro & 63));
  } else {
    ivec2 p = ivec2(dest_xy);
    int inner = ((p.x & 7) + ((p.y & 14) << 2)) << 2;
    int macro = (((((p.x >> 5) + ((p.y >> 5) * int(dest_pitch >> 5u))) << 9) + ((inner & -16) << 1)) +
                 (inner & 15)) + ((p.y & 1) << 4);
    dest_address = uint(((((macro & -512) << 3) + ((p.y & 16) << 7)) + ((macro & 448) << 2)) +
                        (((((p.y & 8) >> 2) + (p.x >> 3)) & 3) << 6) + (macro & 63));
  }
  uint dest_index = (dest_address + xe_resolve.dest_base) >> 4u;
  xe_dest.data[dest_index] = EndianSwap(pixels_low, endian);
  xe_dest.data[dest_index + 2u] = EndianSwap(pixels_high, endian);
}
